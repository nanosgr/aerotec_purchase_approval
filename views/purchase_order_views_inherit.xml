<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_form_inherit_product_domain" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.product.domain</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Agregar campo de dominio calculado y aplicarlo al selector de producto -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="before">
                <field name="product_id_domain" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">product_id_domain</attribute>
            </xpath>

        </field>
    </record>

</odoo>

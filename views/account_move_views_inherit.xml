<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.move.form.inherit.purchase.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Campos computados necesarios para las condiciones de los botones -->
            <!-- Se insertan junto a los otros campos invisibles en el sheet -->
            <xpath expr="//sheet//field[@name='id']" position="after">
                <field name="requires_approval" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="approver_id" invisible="1"/>
                <field name="is_current_user_approver" invisible="1"/>
                <field name="approval_date" invisible="1"/>
            </xpath>

            <!-- Ocultar el botón "Confirm" (facturas/bills) cuando requiere aprobación no otorgada.
                 Se identifica por contener 'display_inactive_currency_warning' en su @invisible,
                 atributo único de ese botón que lo diferencia del botón "Post" (asientos). -->
            <xpath expr="//button[@name='action_post'][contains(@invisible,'display_inactive_currency_warning')]" position="attributes">
                <attribute name="invisible">
                    hide_post_button or move_type == 'entry' or display_inactive_currency_warning or (move_type == 'in_invoice' and requires_approval and approval_state != 'approved')
                </attribute>
            </xpath>

            <!-- Nuevos botones de flujo de aprobación (antes del botón Confirm) -->
            <xpath expr="//button[@name='action_post'][contains(@invisible,'display_inactive_currency_warning')]" position="before">

                <!-- Solicitar Aprobación: visible para el creador cuando aún no solicitó -->
                <button name="action_request_approval"
                    string="Solicitar aprobación"
                    type="object"
                    class="oe_highlight"
                    groups="account.group_account_invoice"
                    invisible="move_type != 'in_invoice' or not requires_approval or approval_state != 'not_required' or state != 'draft'"/>

                <!-- Aprobar: solo visible para el autorizador configurado en la regla -->
                <button name="action_approve_invoice"
                    string="Aprobar"
                    type="object"
                    class="btn-success"
                    invisible="move_type != 'in_invoice' or approval_state != 'pending' or not is_current_user_approver"
                    confirm="¿Confirma la aprobación de esta factura de proveedor?"/>

                <!-- Rechazar: solo visible para el autorizador -->
                <button name="action_reject_invoice"
                    string="Rechazar"
                    type="object"
                    class="btn-danger"
                    invisible="move_type != 'in_invoice' or approval_state not in ('pending', 'approved') or not is_current_user_approver"
                    confirm="¿Confirma el rechazo de esta factura?"/>

                <!-- Cancelar solicitud: para que el creador retire su solicitud pendiente -->
                <button name="action_cancel_approval_request"
                    string="Cancelar solicitud"
                    type="object"
                    invisible="move_type != 'in_invoice' or approval_state != 'pending' or is_current_user_approver"/>

                <!-- Restablecer tras rechazo: permite al creador corregir y re-solicitar -->
                <button name="action_reset_invoice_approval"
                    string="Corregir y re-solicitar"
                    type="object"
                    invisible="move_type != 'in_invoice' or approval_state != 'rejected'"/>

            </xpath>

            <!-- Sección de información de aprobación en el cuerpo del formulario -->
            <xpath expr="//sheet" position="inside">
                <group string="Autorización de compra"
                    invisible="move_type != 'in_invoice' or not requires_approval"
                    class="mt-2">
                    <group>
                        <field name="approval_state" widget="badge"
                            decoration-muted="approval_state == 'not_required'"
                            decoration-warning="approval_state == 'pending'"
                            decoration-success="approval_state == 'approved'"
                            decoration-danger="approval_state == 'rejected'"/>
                        <field name="approver_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="approval_date" readonly="1"
                            invisible="not approval_date"/>
                        <field name="approval_notes"
                            invisible="approval_state == 'not_required'"/>
                    </group>
                </group>
            </xpath>

            <!-- Campo de dominio oculto para filtrar productos según proveedor -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="before">
                <field name="product_id_domain" column_invisible="1"/>
            </xpath>

            <!-- Aplicar el dominio calculado al selector de producto -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="domain">product_id_domain</attribute>
            </xpath>

        </field>
    </record>

</odoo>

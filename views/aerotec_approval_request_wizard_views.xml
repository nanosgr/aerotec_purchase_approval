<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_request_wizard_form" model="ir.ui.view">
        <field name="name">aerotec.approval.request.wizard.form</field>
        <field name="model">aerotec.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitar autorización">
                <field name="move_id" invisible="1"/>
                <field name="payment_id" invisible="1"/>
                <field name="available_approver_ids" invisible="1" widget="many2many_tags"/>
                <group>
                    <field name="document_label" readonly="1"/>
                    <field name="amount_label" readonly="1"/>
                    <field name="rule_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                    <field name="approver_id"
                           domain="[('id', 'in', available_approver_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="note" placeholder="Detalle o motivo de la compra (opcional)"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Solicitar autorización"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

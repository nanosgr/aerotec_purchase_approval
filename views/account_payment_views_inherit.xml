<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.purchase.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Campos computados necesarios para condiciones de botones -->
            <xpath expr="//sheet//field[@name='id']" position="after">
                <field name="requires_approval" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="approver_ids" invisible="1"/>
                <field name="approved_by_id" invisible="1"/>
                <field name="is_current_user_approver" invisible="1"/>
                <field name="is_current_user_rejecter" invisible="1"/>
                <field name="approval_date" invisible="1"/>
            </xpath>

            <!-- Ocultar el botón Confirm cuando el pago requiere aprobación no otorgada -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">
                    state != 'draft' or (payment_type == 'outbound' and requires_approval and approval_state != 'approved')
                </attribute>
            </xpath>

            <!-- Nuevos botones de flujo de aprobación -->
            <xpath expr="//button[@name='action_post']" position="before">

                <button name="action_request_approval"
                    string="Solicitar aprobación"
                    type="object"
                    class="oe_highlight"
                    invisible="payment_type != 'outbound' or not requires_approval or approval_state != 'not_required' or state != 'draft'"/>

                <button name="action_approve_payment"
                    string="Aprobar"
                    type="object"
                    class="btn-success"
                    invisible="payment_type != 'outbound' or approval_state != 'pending' or not is_current_user_approver"
                    confirm="¿Confirma la aprobación de este pago?"/>

                <button name="action_reject_payment"
                    string="Rechazar"
                    type="object"
                    class="btn-danger"
                    invisible="payment_type != 'outbound' or approval_state not in ('pending', 'approved') or not is_current_user_rejecter"
                    confirm="¿Confirma el rechazo de este pago?"/>

                <button name="action_cancel_approval_request"
                    string="Cancelar solicitud"
                    type="object"
                    invisible="payment_type != 'outbound' or approval_state != 'pending' or is_current_user_approver"/>

                <button name="action_reset_payment_approval"
                    string="Corregir y re-solicitar"
                    type="object"
                    invisible="payment_type != 'outbound' or approval_state != 'rejected'"/>

            </xpath>

            <!-- Sección de información de aprobación -->
            <xpath expr="//sheet" position="inside">
                <group string="Autorización de pago"
                    invisible="payment_type != 'outbound' or not requires_approval"
                    class="mt-2">
                    <group>
                        <field name="approval_state" widget="badge"
                            decoration-muted="approval_state == 'not_required'"
                            decoration-warning="approval_state == 'pending'"
                            decoration-success="approval_state == 'approved'"
                            decoration-danger="approval_state == 'rejected'"/>
                        <field name="approver_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <group>
                        <field name="approved_by_id" readonly="1"
                            invisible="not approved_by_id"/>
                        <field name="approval_date" readonly="1"
                            invisible="not approval_date"/>
                        <field name="approval_notes"
                            invisible="approval_state == 'not_required'"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

</odoo>

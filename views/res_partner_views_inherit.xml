<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_supplier_products" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.supplier.products</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Pestaña de productos relacionados, visible solo para proveedores -->
            <xpath expr="//notebook" position="inside">
                <page string="Productos relacionados" invisible="supplier_rank == 0">
                    <field name="aerotec_supplier_product_ids"
                           context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="product_ids" widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
